# Mutable runtime state (the seen-store); config lives in version control.
feed-filter.db
feed-filter.db-wal
feed-filter.db-shm

# Local seen-store backups (e.g. feed-filter.db.bak-YYYYMMDD plus their sqlite
# -wal/-shm sidecars) — ad-hoc local snapshots, never committed.
feed-filter.db.bak*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.ty_cache/

# Local env / tool caches
.env
.rumdl_cache/

# mise resolves external QA tools at `latest`; we deliberately do not pin them
# (see RISK-004). Ignore any locally-generated lockfile so it is not committed.
mise.lock

# Personal subscription list — local state, never committed.
sites.toml

# Personal selection prompt — local, not committed (copy of prompts/selection.example.md).
prompts/selection.md
