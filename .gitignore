# Mutable runtime state (the seen-store); config lives in version control.
feed-filter.db
feed-filter.db-wal
feed-filter.db-shm

# Persisted Playwright storage-state (anti-bot / clearance cookies, SEC-002).
# Local state, never committed — same class as feed-filter.db / sites.toml.
feed-filter-browser-state.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.ty_cache/

# Local env / tool caches
.env
.rumdl_cache/

# mise resolves external QA tools at `latest`; we deliberately do not pin them
# (see RISK-004). Ignore any locally-generated lockfile so it is not committed.
mise.lock

# Personal subscription list — local state, never committed.
sites.toml
